{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sample report document (.sbview), schema version 1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "title", "columns", "rows"],
  "properties": {
    "schemaVersion": {"const": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "description": {"type": "string", "maxLength": 4000},
    "columns": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"type": "object", "additionalProperties": false, "required": ["key", "label"], "properties": {
      "key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$", "not": {"enum": ["constructor", "prototype", "__proto__"]}},
      "label": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S"}
    }}},
    "rows": {"type": "array", "maxItems": 2000, "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/cell"}}}
  },
  "$defs": {"cell": {"oneOf": [{"type": "string", "maxLength": 4096}, {"type": "number"}, {"type": "boolean"}, {"type": "null"}]}},
  "$comment": "The parser also enforces unique column keys, row keys belonging to the declared columns, finite JS numbers, and text resource limits. The runtime parser is authoritative."
}
